# Copy this file to .env (local) or .env.<NODE_ENV> and fill in real values.
# Never commit real .env files. In staging/production, set these as real
# environment variables or through the deployment's secret manager.

# ----- Application (optional, defaults shown) -----
# development | staging | production
NODE_ENV=development
PORT=3000
# Routes are served at /<API_PREFIX>/v1/... (version is added automatically)
API_PREFIX=api

# ----- Database (required) -----
MONGODB_URI=mongodb://localhost:27017/your-database-name

# ----- Swagger (optional, defaults: false / api/docs) -----
SWAGGER_ENABLED=false
SWAGGER_PATH=api/docs

# ----- CORS (required) -----
# Comma-separated list of allowed origins. "*" is not allowed.
CORS_ORIGIN=http://localhost:5173

# ----- MongoDB tuning (optional, defaults shown) -----
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
# Initial connection retries before startup fails
MONGODB_RETRY_ATTEMPTS=5
MONGODB_RETRY_DELAY_MS=3000
# Build indexes on startup. Default: true, except false when NODE_ENV=production.
# In production, create indexes with: npm run db:indexes:apply
# MONGODB_AUTO_INDEX=true

# ----- Security (optional, defaults shown) -----
# Max JSON / form body size (b, kb, mb)
BODY_LIMIT=100kb
# Rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS per client IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Max time to receive a full request
REQUEST_TIMEOUT_MS=30000
# Number of reverse proxies / load balancers in front of the app (0 = none)
TRUST_PROXY_HOPS=0

# ----- Logging (optional) -----
# fatal | error | warn | info | verbose | debug  (default: debug in development, info otherwise)
# LOG_LEVEL=info
# pretty (readable, colored) | json (one JSON object per line, for log collectors)
# Default: pretty in development, json otherwise
# LOG_FORMAT=json
# One access log line per request (method, path, status, duration)
LOG_HTTP_REQUESTS=true
# Also write rotated log files (keep false in containers; log to stdout instead)
LOG_FILE_ENABLED=false
LOG_DIR=logs
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d

# ----- Lifecycle (optional, defaults shown) -----
# Hard limit for a graceful shutdown before the process is forced to exit
SHUTDOWN_TIMEOUT_MS=10000
# Readiness fails this long before the server closes (default: 0 in development, 5000 otherwise)
# SHUTDOWN_DRAIN_DELAY_MS=5000
# Timeout of the MongoDB ping in readiness checks
HEALTH_DB_TIMEOUT_MS=1500

# ----- Performance (optional, defaults shown) -----
# Max time a route handler may take before 408 REQUEST_TIMEOUT
HANDLER_TIMEOUT_MS=15000
# gzip responses above the threshold (skipped for Cache-Control: no-store responses)
COMPRESSION_ENABLED=true
COMPRESSION_THRESHOLD_BYTES=1024
# Server-side limit (maxTimeMS) for every MongoDB query that doesn't set its own
MONGODB_QUERY_TIMEOUT_MS=10000

# ----- Password hashing: Argon2id (optional, defaults shown = OWASP minimum) -----
# Lower values are rejected. Raise them if the servers have CPU/memory to spare.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ----- Registration flow -----
# Email verification: none | otp | link   (default: otp)
#   none = no email check; otp = 6-digit code by email; link = verification link by email
REGISTRATION_EMAIL_VERIFICATION=otp
# Admin must approve new accounts before they can sign in (default: false)
REGISTRATION_REQUIRE_APPROVAL=false
#   none + false  -> Direct:          Register -> Login
#   otp  + false  -> Email OTP:       Register -> Verify code -> Login
#   link + false  -> Email link:      Register -> Open link -> Login
#   none + true   -> Admin approval:  Register -> Pending -> Admin approves -> Login
#   otp/link + true -> Verify email, then admin approves
APP_NAME=AuthCore
EMAIL_OTP_LENGTH=6
EMAIL_OTP_TTL_MINUTES=10
EMAIL_LINK_TTL_MINUTES=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Frontend page for verification links (required when verification = link).
# The email links to <URL>?token=...; the page POSTs the token to /api/v1/auth/verify-email/link
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
# HMAC secret for stored codes/tokens: email verification and password reset (required).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
VERIFICATION_TOKEN_SECRET=change-me-to-a-random-secret-of-at-least-32-characters

# ----- Password reset -----
# otp = 6-digit code by email (default); link = reset link to PASSWORD_RESET_URL?token=...
PASSWORD_RESET_METHOD=otp
# Code / link validity, wrong-code attempts, and minimum seconds between reset emails per account
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
# Validity of the resetToken returned by /auth/verify-reset-token
PASSWORD_RESET_AUTH_TTL_MINUTES=10
# Frontend page for reset links (required when PASSWORD_RESET_METHOD=link)
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# ----- Scheduled jobs -----
# Password expiry reminders etc. Schedules are configured by admins via
# PUT /api/v1/password-policies/schedulers. Each run happens on one instance only.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30

# ----- Access control -----
# true: members of a sub-group also get the roles assigned to its parent groups
ACCESS_INHERIT_PARENT_GROUPS=false

# ----- Account self-service -----
# Email-change and account-recovery codes
ACCOUNT_CODE_TTL_MINUTES=15
ACCOUNT_CODE_MAX_ATTEMPTS=5
ACCOUNT_CODE_RESEND_COOLDOWN_SECONDS=60
# "Delete my account": days until the permanent purge (recoverable until then; 0 = next purge run)
ACCOUNT_DELETION_GRACE_DAYS=14
ACCOUNT_PURGE_INTERVAL_MINUTES=60
# Account activity history (sign-ins, failed sign-ins, password changes, ...) retention
USER_ACTIVITY_RETENTION_DAYS=90

# ----- File uploads -----
# local = files in STORAGE_LOCAL_DIR (relative to the project folder or absolute; git-ignored)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# Public files (avatars) are served at <FILES_PUBLIC_BASE_URL>/<fileId>
FILES_PUBLIC_BASE_URL=http://localhost:3000/api/v1/files/public
# Largest upload (any purpose) and largest avatar, in MB
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_AVATAR_MAX_SIZE_MB=2
# Files one user can own
UPLOAD_MAX_FILES_PER_USER=200
# Images (avatars and image documents) are re-encoded: auto-rotated, all metadata
# (EXIF, GPS location, camera) removed, avatars cropped to a square, others shrunk to fit
IMAGE_AVATAR_SIZE=512
IMAGE_MAX_DIMENSION=4096
IMAGE_QUALITY=85
# Images with more pixels are rejected before decoding (decompression bombs)
IMAGE_MAX_INPUT_PIXELS=50000000
# Virus scanning with ClamAV (clamd over TCP), e.g. docker run -d -p 3310:3310 clamav/clamav
VIRUS_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# true = reject uploads while ClamAV is unreachable (503); false = accept them unscanned (logged)
VIRUS_SCAN_FAIL_CLOSED=true

# ----- User invites -----
# Frontend page for invite links (?token= is appended)
INVITE_ACCEPT_URL=http://localhost:5173/accept-invite
INVITE_TTL_DAYS=7
INVITE_RESEND_COOLDOWN_SECONDS=60

# ----- Mail -----
# outbox = write emails as files to MAIL_OUTBOX_DIR (development only)
# smtp   = send via SMTP (required in production)
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=mail-outbox
MAIL_FROM=AuthCore <no-reply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
#
# Gmail example (needs 2-Step Verification + an App Password:
# Google Account → Security → App passwords):
#   MAIL_TRANSPORT=smtp
#   MAIL_FROM=YourApp <you@gmail.com>     (must be the account or a verified alias)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false                     (STARTTLS; use 465 + true for TLS on connect)
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop        (16-char app password, no spaces)
# Gmail limits sending (about 500 emails / day); use a transactional provider
# (SES, SendGrid, Mailgun, Postmark, ...) for production.

# ----- Login -----
# Which identifiers can sign in: email | username | email,username (default: email,username)
LOGIN_IDENTIFIERS=email,username
# After LOGIN_MAX_FAILED_ATTEMPTS failures within the window, sign-in is locked for LOGIN_LOCKOUT_MINUTES
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILED_ATTEMPTS_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# Active sessions per user; the oldest is signed out when a new login exceeds it
MAX_SESSIONS_PER_USER=10

# ----- Access token (JWT, HS256) -----
# Required. 32+ random characters, different from VERIFICATION_TOKEN_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-another-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=authcore
JWT_AUDIENCE=authcore-api

# ----- Refresh token / session -----
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_ME_TTL_DAYS=30
# A just-rotated refresh token still works for this many seconds (parallel tabs); later reuse revokes the session
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
# cookie = HttpOnly cookie for browsers (default); body = in the JSON response for mobile apps; both
REFRESH_TOKEN_DELIVERY=cookie
REFRESH_COOKIE_NAME=authcore_refresh
# strict | lax | none   (none requires REFRESH_COOKIE_SECURE=true)
REFRESH_COOKIE_SAMESITE=strict
# Must be true in production. Browsers accept Secure cookies on http://localhost.
REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_DOMAIN=example.com
