# =============================================================================
# AuthCore: repository-wide ignore rules (apply to every folder, incl.
# authcore-backend/). Package-specific rules can live in that package.
# =============================================================================

# ----- Dependencies -----
node_modules/

# ----- Build output -----
dist/
build/
*.tsbuildinfo

# ----- Environment files and secrets (never commit) -----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
secrets/

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ----- Test / coverage output -----
coverage/
.nyc_output/

# ----- Runtime data -----
pids/
*.pid
*.seed
*.pid.lock

# ----- Temporary files -----
.tmp/
.temp/
tmp/

# ----- Editors and IDEs -----
.idea/
*.iml
.project
.classpath
.settings/
.c9/
*.launch
*.sublime-workspace
*.swp
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ----- Operating system files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Local email outbox (development) -----
mail-outbox/

# Backend build used by the Playwright test environment (playwrite/test-env).
authcore-backend/dist-pw/
