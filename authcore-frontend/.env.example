# AuthCore Frontend — environment variables
# Copy to .env (git-ignored). Every VITE_ variable ends up in the browser bundle:
# never put secrets here. Read only through src/config/env.ts; types in src/types/env.d.ts.

# API root. "/api/v1" uses the Vite dev proxy to http://localhost:3000 (same origin, so the
# refresh cookie and the backend's origin check work). Production: same-origin path behind
# the web server, or a full URL such as https://api.example.com/api/v1.
VITE_API_BASE_URL=/api/v1

# Request timeout in milliseconds (default 30000 = 30 s; 0 = no timeout). File uploads have no
# timeout unless the call sets one. The backend has its own handler timeout (408).
VITE_API_TIMEOUT_MS=30000
