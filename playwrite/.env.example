# Copy to .env (never committed).

# Which AuthCore the tests use:
#   test (default)  the separate test environment: npm run env:test
#   dev             your dev servers (below) — your dev data, and real email may be sent
PW_ENV=test

# Test environment admin password: written here by "npm run env:test" on its first start.
E2E_TEST_ADMIN_PASSWORD=

# Only for PW_ENV=dev: your dev frontend and an ADMIN account there.
PW_BASE_URL=http://localhost:5173
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
