# Copy to .env (never committed) and fill in.

# The frontend to test. Default: the Vite dev server.
# Prefer a test environment (its own database, MAIL_TRANSPORT=outbox) so tests never touch
# real data or send real email.
PW_BASE_URL=http://localhost:5173

# An ADMIN account on that environment (the setup step signs in with it once).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
